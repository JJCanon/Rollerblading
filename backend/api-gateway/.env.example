# Server
PORT = 8080
NODE_ENV = development

# JWT (Same as auth - service)
JWT_SECRET=change_me_to_a_long_random_string

# Microservices (intern URL's, name in docker compose)
AUTH_SERVICE_URL=http://auth-service:3001
CONTENT_SERVICE_URL=http://content-service:3002
EVENTS_SERVICE_URL=http://events-service:3003
STORE_SERVICE_URL=http://store-service:3004

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10