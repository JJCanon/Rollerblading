# ── Auth DB ──
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me
AUTH_DB_NAME=auth_db

# ── Events DB ──
EVENTS_DB_USER=events_user
EVENTS_DB_PASSWORD=change_me
EVENTS_DB_NAME=events_db

# ── Store DB ──
STORE_DB_USER=store_user
STORE_DB_PASSWORD=change_me
STORE_DB_NAME=store_db

# ── Content DB (Mongo) ──
CONTENT_DB_USER=content_user
CONTENT_DB_PASSWORD=change_me
CONTENT_DB_NAME=content_db

# ── JWT (compartido entre Auth Service y el resto para validar firma) ──
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Integraciones externas (se llenan en Fase 7) ──
INSTAGRAM_GRAPH_API_TOKEN=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
MERCADOPAGO_ACCESS_TOKEN=